<Window x:Class="Chudo_obuv.ShoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - каталог обуви"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#D2F6E7">
            <Grid>
                <Image Source="/res/Чудо Обувь.png"
                       Width="56" Height="56"
                       HorizontalAlignment="Left"
                       Margin="16,0,0,0"/>

                <TextBlock Text="Каталог обуви"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="88,0,0,0"/>

                <TextBlock x:Name="UserNameText"
                           Text="Гость"
                           FontSize="18"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <StackPanel x:Name="CatalogControls"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
                    <TextBlock Text="Поиск:"
                               VerticalAlignment="Center"   
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="ProductSearch"
                             Width="150"
                             Margin="0,0,12,0"
                             ToolTip="Поиск по названию и описанию"/>
                    
                    <ComboBox x:Name="CategoryFilter"
              Width="170"
              Margin="0,0,12,0"
              DisplayMemberPath="CategoryName"/>

                    <ComboBox x:Name="PriceSort" Width="170">
                        <ComboBoxItem Content="Без сортировки"/>
                        <ComboBoxItem Content="По возрастанию"/>
                        <ComboBoxItem Content="По убыванию"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ShoesList" Margin="24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding CardBackground}"
                                BorderBrush="#70B2AF"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,12"
                                Tag="{Binding ProductId}"
                                MouseLeftButtonUp="ProductCard_Click">

                            <Grid MinHeight="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding Image}"
                                       Width="90" Height="80"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       ImageFailed="Image_ImageFailed"/>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Text="{Binding CategoryText}"
                                               FontSize="15"/>

                                    <TextBlock Text="{Binding QuantityText}"
                                               FontSize="15"/>

                                    <TextBlock Text="{Binding CompositionText}"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding PriceText}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,16">
            <Button Content="Выйти" Padding="16,6" Click="Exit_Click"/>
            <Button x:Name="CartButton" Content="Корзина" Padding="16,6"
                    Margin="12,0,0,0" Visibility="Collapsed" Click="Cart_Click"/>
        </StackPanel>
    </Grid>
</Window>
