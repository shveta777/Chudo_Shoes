<Window x:Class="Chudo_obuv.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - корзина" Height="450" Width="800"
        MinHeight="330" MinWidth="660" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="20,12">
            <TextBlock Text="Корзина" FontSize="25" FontWeight="Bold"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
            <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Margin="0,8"/>
            <WrapPanel>
                <Button x:Name="ConfirmButton" Content="Подтвердить заказ"
                        Padding="12,6" Click="Confirm_Click"/>
                <Button x:Name="RemoveButton" Content="Убрать позицию"
                        Padding="12,6" Margin="8,0,0,0" Click="Remove_Click"/>
                <Button x:Name="CancelButton" Content="Отменить заказ"
                        Padding="12,6" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button Content="К каталогу" Padding="12,6" Margin="8,0,0,0" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="CartList" Margin="20,16,20,0"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="75"/>
                <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="65"/>
                <DataGridTextColumn Header="Цена за пару" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₽'}" Width="110"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat='{}{0:N2} ₽'}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
