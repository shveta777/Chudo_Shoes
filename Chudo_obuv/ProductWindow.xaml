<Window x:Class="Chudo_obuv.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - товар" Height="580" Width="800"
        MinHeight="400" MinWidth="560" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="20,12">
            <TextBlock Text="{Binding Product.ProductName}" FontSize="25"
                       FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20">
            <Button x:Name="AddButton" Content="Добавить в корзину" Padding="16,6"
                    IsDefault="True" Click="Add_Click"/>
            <Button Content="Назад" Padding="16,6" Margin="12,0,0,0" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Image}" Width="160" Height="160"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Stretch="Uniform" ImageFailed="Image_ImageFailed"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Product.Manufacturer.ManufacturerName, StringFormat='Производитель: {0}'}"
                               FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Product.Subcategory.Category.CategoryName, StringFormat='Категория: {0}'}"
                               FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="20" Margin="0,8"/>
                    <TextBlock Text="Состав" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Product.Composition}" TextWrapping="Wrap"/>
                    <TextBlock Text="Описание" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Product.Description}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SizeRangeText" TextWrapping="Wrap" Margin="0,12,0,8"/>

                    <TextBlock Text="Доступные размеры"/>
                    <ComboBox x:Name="AvailableSizes" DisplayMemberPath="Size.SizeValue"
                              Width="150" HorizontalAlignment="Left" Margin="0,4"
                              SelectionChanged="AvailableSizes_SelectionChanged"/>
                    <TextBlock x:Name="AvailableQuantityText"/>
                    <TextBlock Text="Количество пар" Margin="0,8,0,0"/>
                    <TextBox x:Name="QuantityInput" Text="1" Width="100"
                             HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
