<Window x:Class="Chudo_obuv.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь - заказы" Width="950" Height="690"
        MinWidth="790" MinHeight="560" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="20,12">
            <TextBlock Text="Заказы" FontSize="25" FontWeight="Bold"/>
        </Border>

        <WrapPanel DockPanel.Dock="Top" Margin="20,12">
            <Button Content="Новый заказ" Padding="12,6" Click="StartOrder_Click"/>
            <Button x:Name="DeleteOrderButton" Content="Удалить заказ" Padding="12,6"
                    Margin="8,0,0,0" Click="DeleteOrder_Click"/>
        </WrapPanel>

        <Border x:Name="NewOrderPanel" DockPanel.Dock="Top" Background="#D2F6E7"
                Padding="12,8" Margin="20,0,20,12" Visibility="Collapsed">
            <WrapPanel>
                <TextBlock Text="Клиент" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ClientPicker" Width="250" DisplayMemberPath="FullName"
                          Margin="0,0,8,0" VerticalAlignment="Center"
                          SelectionChanged="ClientPicker_SelectionChanged"/>
                <Button x:Name="ChooseProductsButton" Content="Выбрать товары" Padding="12,6"
                        IsEnabled="False" Click="NewOrder_Click"/>
                <Button Content="Отмена" Padding="12,6" Margin="8,0,0,0"
                        Click="CancelNewOrder_Click"/>
            </WrapPanel>
        </Border>

        <Button DockPanel.Dock="Bottom" Content="Закрыть" IsCancel="True"
                Padding="16,6" Margin="20,12" HorizontalAlignment="Left"/>

        <Grid Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" SelectedValuePath="OrderId"
                      SelectionChanged="OrdersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="65"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Клиент" Width="*">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                <Binding Path="User.LastName"/>
                                <Binding Path="User.FirstName"/>
                                <Binding Path="User.Patronymic"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="OrderItemsTitle" Grid.Row="1" Text="Состав заказа" FontSize="18"
                       FontWeight="Bold" Margin="0,12,0,6"/>

            <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" SelectionChanged="ItemsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Product.ProductName}" Width="2*"/>
                    <DataGridTextColumn Header="Производитель" Binding="{Binding Product.Manufacturer.ManufacturerName}" Width="*"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding Size.SizeValue}" Width="75"/>
                    <DataGridTextColumn Header="Пар" Binding="{Binding Quantity, StringFormat=0.####}" Width="60"/>
                    <DataGridTextColumn Header="Цена за пару" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₽'}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="TotalText" Grid.Row="3" FontSize="18"
                       FontWeight="Bold" Margin="0,8,0,0"/>

            <WrapPanel x:Name="AdminControls" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
                <DatePicker x:Name="OrderDatePicker" Width="135" VerticalAlignment="Center"/>
                <Button x:Name="SaveDateButton" Content="Сохранить дату" Padding="12,6"
                        Margin="8,0,0,0" Click="SaveDate_Click"/>
                <Button x:Name="DeleteItemButton" Content="Удалить позицию" Padding="12,6"
                        Margin="8,0,0,0" Click="DeleteItem_Click"/>
            </WrapPanel>
        </Grid>
    </DockPanel>
</Window>
